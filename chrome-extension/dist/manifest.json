{
  "manifest_version": 3,
  "name": "Prompt Smith - AI Prompt Engineer",
  "version": "1.0.0",
  "description": "Refine your prompts for ChatGPT, Claude, and Gemini using elite prompt engineering rules.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://bard.google.com/*",
    "https://poe.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "index.html",
    "default_title": "Refine Prompt"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/content.ts-N1qRnwDH.js"
      ],
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://bard.google.com/*",
        "https://poe.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://bard.google.com/*",
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://perplexity.ai/*",
        "https://poe.com/*",
        "https://www.perplexity.ai/*"
      ],
      "resources": [
        "index.html",
        "assets/*",
        "icons/*",
        "assets/content.ts-N1qRnwDH.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
